@page "/clients"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Clienti</PageTitle>

<div class="container-fluid px-4 py-4">
    @if (ListOfClients!.Count == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
            <div class="text-center">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Caricamento...</span>
                </div>
                <p class="text-muted fs-5 fw-light">Caricamento clienti in corso...</p>
            </div>
        </div>
    }
    else
    {
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                    <i class="bi bi-people-fill me-2"></i>Gestione Clienti
                </h2>
                <p class="text-muted mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Totale clienti: <span class="badge bg-primary rounded-pill ms-1">@ListOfClients.Count</span>
                </p>
            </div>
            <button class="btn btn-primary btn-lg rounded-3 shadow-sm" @onclick="AddNewClient">
                <i class="bi bi-plus-circle me-2"></i>Nuovo Cliente
            </button>
        </div>

        <!-- Table Section -->
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">ID</th>
                                <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">NOME</th>
                                <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">COGNOME</th>
                                <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">EMAIL</th>
                                <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">TELEFONO</th>
                                <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">CITTÀ</th>
                                <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">CAP</th>
                                <th class="pe-4 py-3 text-secondary fw-semibold text-center" style="font-size: 0.85rem;">AZIONI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in ListOfClients)
                            {
                                <tr style="transition: background-color 0.2s ease;">
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark rounded-pill px-3 py-2">
                                            #@cliente.Id
                                        </span>
                                    </td>
                                    <td class="fw-medium">@cliente.Nome</td>
                                    <td class="fw-medium">@cliente.Cognome</td>
                                    <td>
                                        <a href="mailto:@cliente.Email" class="text-decoration-none text-primary">
                                            <i class="bi bi-envelope me-1"></i>@cliente.Email
                                        </a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(cliente.Telefono))
                                        {
                                            <span>
                                                <i class="bi bi-telephone me-1 text-muted"></i>@cliente.Telefono
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">N/D</span>
                                        }
                                    </td>
                                    <td>
                                        <span>
                                            <i class="bi bi-geo-alt me-1 text-muted"></i>@cliente.Citta
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3">
                                            @cliente.Cap
                                        </span>
                                    </td>
                                    <td class="pe-4 text-center">
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button class="btn btn-outline-warning btn-sm rounded-3 px-3">
                                                <i class="bi bi-pencil-square me-1"></i>Modifica
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm rounded-3 px-3" 
                                                    @onclick="() => DeletClient(cliente)">
                                                <i class="bi bi-trash me-1"></i>Elimina
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Mobile Add Button -->
        <div class="text-center mt-4 d-md-none">
            <button class="btn btn-primary btn-lg rounded-3 shadow w-100" @onclick="AddNewClient">
                <i class="bi bi-plus-circle me-2"></i>Nuovo Cliente
            </button>
        </div>
    }
</div>

@code {
    List<Client>? ListOfClients = new List<Client>();

    protected override async Task OnInitializedAsync()
    {
        ListOfClients = await Http.GetFromJsonAsync<List<Client>>("/api/clients");
    }

    protected void DeletClient(Client c)
    {
        ListOfClients!.Remove(c);
    }

    private void AddNewClient()
    {
        Nav.NavigateTo("/clients/add");
    }
}