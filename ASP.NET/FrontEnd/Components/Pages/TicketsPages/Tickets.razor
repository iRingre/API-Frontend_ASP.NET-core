@page "/tickets"
@using System.Collections
@inject HttpClient Http

@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Tickets</PageTitle>

<div class="container-fluid px-4 py-4">
    
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center">
            <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3">
                <i class="bi bi-ticket-detailed fs-3 text-primary"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-1" style="color: #2c3e50;">Gestione Tickets</h3>
                <p class="text-muted mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Gestisci e monitora tutti i ticket di assistenza
                </p>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary rounded-3 px-3" @onclick="@OnInitializedAsync">
                <i class="bi bi-arrow-clockwise me-2"></i>Ricarica Tickets
            </button>
            <button class="btn btn-success rounded-3 px-3 shadow-sm" @onclick="@send">
                <i class="bi bi-check-all me-2"></i>Salva Tutte le Modifiche
            </button>
            <button class="btn btn-primary rounded-3 px-4 shadow-sm" @onclick="@NewTicket">
                <i class="bi bi-plus-circle me-2"></i>Aggiungi Ticket
            </button>
        </div>
    </div>

    <!-- Table Section -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-hash me-1"></i>ID
                            </th>
                            <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-building me-1"></i>AZIENDA CLIENTE
                            </th>
                            <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-person me-1"></i>CLIENTE
                            </th>
                            <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-file-text me-1"></i>OGGETTO
                            </th>
                            <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-flag me-1"></i>STATO
                            </th>
                            <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-exclamation-triangle me-1"></i>PRIORITÀ
                            </th>
                            <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-person-check me-1"></i>ASSEGNATO A
                            </th>
                            <th class="py-3 text-secondary fw-semibold" style="font-size: 0.85rem;">
                                <i class="bi bi-calendar me-1"></i>APERTO IL
                            </th>
                            <th class="pe-4 py-3 text-secondary fw-semibold text-center" style="font-size: 0.85rem;">
                                <i class="bi bi-gear me-1"></i>AZIONI
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Tick == null || !Tick.Any())
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="text-center py-5">
                                        @if (isLoading)
                                        {
                                            <div class="d-flex flex-column align-items-center">
                                                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                                    <span class="visually-hidden">Caricamento...</span>
                                                </div>
                                                <p class="text-muted fs-5 fw-light">Caricamento tickets in corso...</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column align-items-center">
                                                <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                                                <p class="text-muted fs-5 fw-light mb-2">Nessun ticket disponibile</p>
                                                <p class="text-muted small">Clicca "Ricarica Tickets" per visualizzarli</p>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ticket in Tick)
                            {
                                <tr style="transition: all 0.2s ease;">
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark rounded-pill px-3 py-2">
                                            #@ticket.Id
                                        </span>
                                    </td>
                                    <td class="fw-medium">@ticket.DatiCliente</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-secondary bg-opacity-10 p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                <i class="bi bi-person small text-secondary"></i>
                                            </div>
                                            @ticket.Richiedente
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" 
                                              title="@ticket.DescrizioneDettagliata">
                                            @ticket.DescrizioneDettagliata
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-badge @GetStatusClass(ticket.Categoria)">
                                            @ticket.Categoria
                                        </span>
                                    </td>
                                    <td>
                                        <span class="priority-badge @GetPriorityClass(ticket.Urgenza)">
                                            @ticket.Urgenza
                                        </span>
                                    </td>
                                    <td>@ticket.Assegnatario</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-calendar-date me-2 text-muted"></i>
                                            @ticket.DataCreazione
                                        </div>
                                    </td>
                                    <td class="pe-4 text-center">
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button class="btn btn-outline-warning btn-sm rounded-3 px-3" 
                                                    @onclick="()=>ModificaTicket(ticket)">
                                                <i class="bi bi-pencil-square me-1"></i>Modifica
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm rounded-3 px-3" 
                                                    @onclick="()=>DeleteTicket(ticket)">
                                                <i class="bi bi-trash me-1"></i>Elimina
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (editingTicket != null)
        {
            <div class="modal-overlay">
                <div class="modal-box">
                
                    @if(editingTicket.Id == 0){<h4>Crea Ticket</h4>}
                    else {<h4>Modifica Ticket @editingTicket.Id</h4>}

                    <EditForm Model="editingTicket">

                        <div class="form-group">
                            <label>Dati Cliente</label>
                            <InputText @bind-Value="editingTicket.DatiCliente" />
                        </div>

                        <div class="form-group">
                            <label>Richiedente</label>
                            <InputText @bind-Value="editingTicket.Richiedente" />
                        </div>

                        <div class="form-group">
                            <label>Descrizione</label>
                            <InputTextArea @bind-Value="editingTicket.DescrizioneDettagliata" class="textarea-big" />
                        </div>

                        <div class="form-group">
                            <label>Categoria</label>
                            <InputSelect @bind-Value="editingTicket.Categoria">
                                <option value="Aperto">Aperto</option>
                                <option value="In lavorazione">In lavorazione</option>
                                <option value="Chiuso">Chiuso</option>
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label>Urgenza</label>
                            <InputSelect @bind-Value="editingTicket.Urgenza">
                                <option value="Alta">Alta</option>
                                <option value="Media">Media</option>
                                <option value="Bassa">Bassa</option>
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label>Assegnatario</label>
                            <InputText @bind-Value="editingTicket.Assegnatario" />
                        </div>

                        <div class="modal-actions">
                            <button type="button" @onclick="() => SaveSingleTicket(editingTicket.Id)">
                                Salva
                            </button>

                            <button type="button" class="btn-cancel" @onclick="Annulla">
                                Annulla
                            </button>
                        </div>

                    </EditForm>

                </div>
            </div>
        }

@code {
    private bool isLoading = false;
    List<Ticket>? Tick, TickToSave, TickToDelete = new List<Ticket>();
    Ticket? editingTicket;
    
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try 
        {
            TickToSave = new List<Ticket>();
            TickToDelete = new List<Ticket>();
            Tick = new List<Ticket>();
            await Task.Delay(300);
            Tick = await Http.GetFromJsonAsync<List<Ticket>>("/api/tickets");
            
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private string GetStatusClass(string status)
    {
        return status?.ToLower() switch
        {
            "aperto" => "open",
            "in lavorazione" => "in-progress",
            "chiuso" => "closed",
            _ => ""
        };
    }
    
    private string GetPriorityClass(string priority)
    {
        return priority?.ToLower() switch
        {
            "alta" => "high",
            "media" => "medium",
            "bassa" => "low",
            _ => ""
        };
    }

    private async Task send(){
        if(TickToSave!.Count > 0){
            await Http.PostAsJsonAsync("/api/savetickets", TickToSave);
            TickToSave = new List<Ticket>();
        }else {
            Console.WriteLine("non c'è stata alcuna modifica nei tickets");
        }
        if(TickToDelete!.Count > 0){
            await Http.PostAsJsonAsync("/api/deleteTickets", TickToDelete);
            TickToDelete = new List<Ticket>();
        }else {
            Console.WriteLine("non c'è stata alcuna eliminazione nei tickets");
        }
        await OnInitializedAsync();
    }

    private void ModificaTicket(Ticket ticket)
    {
        editingTicket = new Ticket(

            ticket.Id,
            ticket.Assegnatario,
            ticket.Categoria,
            ticket.DatiCliente,
            ticket.DescrizioneDettagliata,
            ticket.Richiedente,
            ticket.Urgenza,
            ticket.DataCreazione
        );
    }
    private void Annulla(){
        editingTicket = null;
    }

    private void SaveSingleTicket(int id){
        var t = new Ticket(
                    editingTicket!.Id,
                    editingTicket.Assegnatario,
                    editingTicket.Categoria,
                    editingTicket.DatiCliente,
                    editingTicket.DescrizioneDettagliata,
                    editingTicket.Richiedente,
                    editingTicket.Urgenza,
                    editingTicket.DataCreazione
                );
        for(int i = 0; i< Tick!.Count; i++){
            if(Tick[i].Id == id){
                Tick[i] = t;
                if(TickToSave!.Count>0){
                    for(int j = 0; j< TickToSave!.Count; j++){
                        if(TickToSave[j].Id == Tick[i].Id){
                            TickToSave[j] = Tick[i];
                            editingTicket = null;
                            return;
                        }
                    }
                }
                TickToSave!.Add(Tick[i]);
                editingTicket = null;
                return;
            }
        }

        TickToSave!.Add(t);
        Tick.Add(t);
        editingTicket = null;
        return;
    }

    private void NewTicket(){
        editingTicket = new Ticket(

            0,
            "",
            "",
            "",
            "",
            "",
            "",
            DateTime.UtcNow
        );
    }

    private void DeleteTicket(Ticket t){
        TickToDelete!.Add(t);
        Tick!.Remove(t);
    }
}
